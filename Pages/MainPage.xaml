<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Uninstaller.Models"
             x:Class="Uninstaller.Pages.MainPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera en dos lineas: contador con el criterio de orden, y una fila de botones de
             icono. Antes ocupaba cuatro bloques (titulo, buscador, conmutador y dos botones con
             texto) y se comia media pantalla que es para la lista (nota de autor del 2026-09-13).
             El buscador solo aparece al pulsar la lupa. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,6">
            <VerticalStackLayout Padding="16,12" Spacing="10">
                <!-- El contador muestra tambien el criterio de orden y abre el selector al
                     pulsarlo, ademas del boton de ordenar. -->
                <Label x:Name="CountLabel"
                       Style="{StaticResource CardTitle}"
                       FontSize="16"
                       LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSortClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0"
                            x:Name="SortButton"
                            Style="{StaticResource IconButton}"
                            ImageSource="sort.png"
                            Clicked="OnSortClicked" />
                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Style="{StaticResource IconButton}"
                            ImageSource="ic_refresh.png"
                            Clicked="OnRefreshClicked" />
                    <Button Grid.Column="2"
                            x:Name="SearchButton"
                            Style="{StaticResource IconButton}"
                            ImageSource="ic_search.png"
                            Clicked="OnSearchClicked" />
                    <Button Grid.Column="3"
                            x:Name="SelectAllButton"
                            Style="{StaticResource IconButton}"
                            ImageSource="ic_select_all.png"
                            Clicked="OnSelectAllClicked" />
                    <Button Grid.Column="4"
                            x:Name="ClearButton"
                            Style="{StaticResource IconButton}"
                            ImageSource="ic_clear_selection.png"
                            Clicked="OnClearClicked" />
                    <!-- Conmutador de apps del sistema: relleno cuando esta activo. -->
                    <Button Grid.Column="5"
                            x:Name="ShowSystemButton"
                            Style="{StaticResource IconButton}"
                            ImageSource="ic_system.png"
                            Clicked="OnShowSystemClicked" />
                </Grid>

                <!-- Buscador: con cien aplicaciones instaladas, desplazarse hasta la que se
                     busca no es razonable (nota de autor del 2026-08-25). Oculto hasta que se
                     pulsa la lupa; al cerrarlo se vacia el filtro. -->
                <Grid x:Name="SearchRow" IsVisible="False" VerticalOptions="Center">
                    <!-- El aspa de borrar la pone el propio Entry; no hace falta otra al lado. -->
                    <Entry x:Name="SearchEntry"
                           ReturnType="Search"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="OnSearchTextChanged" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Lista de aplicaciones -->
        <RefreshView Grid.Row="1" x:Name="ListRefresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="AppsList" SelectionMode="None" Margin="12,6,12,6">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledApp">
                        <Border Style="{StaticResource Card}" Margin="0,4" Padding="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Grid.GestureRecognizers>

                                <!-- Icono en circulo -->
                                <Border Grid.Column="0"
                                        WidthRequest="44" HeightRequest="44"
                                        Padding="6"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource IconTileLight}, Dark={StaticResource IconTileDark}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding Icon}" Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Label}" Style="{StaticResource BodyText}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PackageName}" Style="{StaticResource HintText}" LineBreakMode="MiddleTruncation" />
                                    <!-- Fecha de instalacion, ultima actualizacion y tamano: son los
                                         criterios por los que se puede ordenar, asi que se ven en la fila. -->
                                    <Label Text="{Binding Details}" Style="{StaticResource HintText}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Color="{StaticResource Primary}"
                                          VerticalOptions="Center"
                                          CheckedChanged="OnItemCheckedChanged" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="8" VerticalOptions="Center">
                        <Label x:Name="EmptyLabel"
                               Style="{StaticResource CardTitle}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                        <Label x:Name="EmptyHintLabel"
                               Style="{StaticResource HintText}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Overlay de carga -->
        <Grid Grid.Row="1"
              x:Name="LoadingOverlay"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
              Opacity="0.92">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" WidthRequest="42" HeightRequest="42" />
                <Label x:Name="LoadingLabel" Style="{StaticResource HintText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Accion principal: desinstalar seleccionadas -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="12,6,12,12">
            <Button x:Name="UninstallButton"
                    Style="{StaticResource DangerButton}"
                    Clicked="OnUninstallSelectedClicked"
                    IsEnabled="False"
                    Margin="8"
                    HorizontalOptions="Fill" />
        </Border>

    </Grid>

</ContentPage>
