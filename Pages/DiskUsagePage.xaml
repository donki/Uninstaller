<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Uninstaller.Models"
             xmlns:services="clr-namespace:Uninstaller.Services"
             x:Class="Uninstaller.Pages.DiskUsagePage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera: que escanear, estado del escaneo, vistas y acciones. Solo iconos, como el
             resto de la aplicacion (constitucion). -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,6">
            <VerticalStackLayout Padding="16,12" Spacing="10">

                <!-- Unidad o ruta (tambien \\servidor\recurso), escanear y parar. -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Picker Grid.Column="0" x:Name="DrivePicker" MinimumWidthRequest="150"
                            SelectedIndexChanged="OnDriveChanged" />
                    <Entry Grid.Column="1" x:Name="PathEntry" ReturnType="Go" Completed="OnScanClicked" />
                    <Button Grid.Column="2" x:Name="ScanButton" Style="{StaticResource IconButton}"
                            ImageSource="ic_play.png" Clicked="OnScanClicked" />
                    <Button Grid.Column="3" x:Name="StopButton" Style="{StaticResource IconButton}"
                            ImageSource="ic_stop.png" Clicked="OnStopClicked" IsEnabled="False" />
                </Grid>

                <!-- Estado: lo escaneado hasta ahora (o el resumen final). -->
                <Label x:Name="StatusLabel" Style="{StaticResource HintText}" LineBreakMode="MiddleTruncation" />
                <ProgressBar x:Name="ScanProgress" IsVisible="False" ProgressColor="{StaticResource Primary}" />

                <!-- Una sola fila a todo el ancho: vistas (arbol, mapa, grandes, tipos, antigüedad,
                     duplicados) y acciones (subir, Explorador, copiar ruta, papelera, CSV). -->
                <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" x:Name="TreeButton" Style="{StaticResource IconButton}" ImageSource="ic_tree.png" Clicked="OnViewClicked" />
                    <Button Grid.Column="1" x:Name="MapButton" Style="{StaticResource IconButton}" ImageSource="ic_treemap.png" Clicked="OnViewClicked" />
                    <Button Grid.Column="2" x:Name="LargestButton" Style="{StaticResource IconButton}" ImageSource="ic_biggest.png" Clicked="OnViewClicked" />
                    <Button Grid.Column="3" x:Name="TypesButton" Style="{StaticResource IconButton}" ImageSource="ic_types.png" Clicked="OnViewClicked" />
                    <Button Grid.Column="4" x:Name="AgeButton" Style="{StaticResource IconButton}" ImageSource="ic_clock.png" Clicked="OnViewClicked" />
                    <Button Grid.Column="5" x:Name="DuplicatesButton" Style="{StaticResource IconButton}" ImageSource="ic_duplicates.png" Clicked="OnViewClicked" />
                    <Button Grid.Column="6" x:Name="UpButton" Style="{StaticResource IconButton}" ImageSource="ic_up.png" Clicked="OnUpClicked" IsEnabled="False" />
                    <Button Grid.Column="7" x:Name="OpenButton" Style="{StaticResource IconButton}" ImageSource="ic_open.png" Clicked="OnOpenClicked" IsEnabled="False" />
                    <Button Grid.Column="8" x:Name="CopyButton" Style="{StaticResource IconButton}" ImageSource="ic_copy_path.png" Clicked="OnCopyClicked" IsEnabled="False" />
                    <Button Grid.Column="9" x:Name="DeleteButton" Style="{StaticResource IconButton}" ImageSource="ic_trash.png" BorderColor="#D14343" Clicked="OnDeleteClicked" IsEnabled="False" />
                    <Button Grid.Column="10" x:Name="ExportButton" Style="{StaticResource IconButton}" ImageSource="ic_export.png" Clicked="OnExportClicked" IsEnabled="False" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Arbol de carpetas, aplanado: sangria por profundidad y desplegable por fila. La casilla
             marca varias para mandarlas a la papelera (o copiar sus rutas) de una vez. -->
        <CollectionView Grid.Row="1" x:Name="TreeList" Margin="12,6,12,12" SelectionMode="Single" SelectionChanged="OnSelectionChanged" ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FolderNode">
                    <Border Style="{StaticResource ListRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Buttons="Secondary" Tapped="OnRowSecondaryTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Padding="4,6,10,6" Margin="{Binding Indent}">
                            <!-- Desplegable: zona de toque de 40 x 40 con el triangulo grande (antes era
                                 una letra de 18 px, dificil de acertar con el raton). -->
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0"
                                    StrokeShape="Rectangle" BackgroundColor="Transparent"
                                    Opacity="{Binding ExpanderOpacity}" VerticalOptions="Center">
                                <Image Source="{Binding ExpanderIcon}" WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnExpanderTapped" />
                                    <PointerGestureRecognizer PointerEntered="OnExpanderPointerEntered" PointerExited="OnExpanderPointerExited" />
                                </Border.GestureRecognizers>
                            </Border>
                            <!-- Icono del sistema (el de carpeta, o el propio de la unidad en la raiz). -->
                            <Image Grid.Column="1" Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="{Binding Display}" Style="{StaticResource BodyText}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                                <ProgressBar Progress="{Binding Percent}" ProgressColor="{StaticResource Primary}" HeightRequest="4" />
                                <Label Text="{Binding DetailText}" Style="{StaticResource HintText}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource BodyText}" FontAttributes="Bold" VerticalOptions="Center" />
                            <CheckBox Grid.Column="4" IsChecked="{Binding IsChecked, Mode=TwoWay}" Color="{StaticResource Primary}" VerticalOptions="Center" CheckedChanged="OnItemCheckedChanged" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label x:Name="EmptyLabel" Style="{StaticResource HintText}" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" Padding="30" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Mapa de rectangulos (treemap): un toque elige la carpeta, dos entran en ella; la flecha sube. -->
        <Border Grid.Row="1" x:Name="MapPanel" Style="{StaticResource Card}" Margin="12,6,12,12" Padding="4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
                <Label Grid.Row="0" x:Name="MapLabel" Style="{StaticResource HintText}" Padding="8,4" LineBreakMode="MiddleTruncation" />
                <GraphicsView Grid.Row="1" x:Name="MapView">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMapTapped" NumberOfTapsRequired="1" />
                        <TapGestureRecognizer Tapped="OnMapDoubleTapped" NumberOfTapsRequired="2" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>
            </Grid>
        </Border>

        <!-- Ficheros mas grandes -->
        <CollectionView Grid.Row="1" x:Name="LargestList" Margin="12,6,12,12" SelectionMode="Single" SelectionChanged="OnSelectionChanged" IsVisible="False" ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FileRow">
                    <Border Style="{StaticResource ListRow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Buttons="Secondary" Tapped="OnRowSecondaryTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="12,8">
                            <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Display}" Style="{StaticResource BodyText}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                                <Label Text="{Binding Folder}" Style="{StaticResource HintText}" LineBreakMode="MiddleTruncation" />
                                <ProgressBar Progress="{Binding Percent}" ProgressColor="{StaticResource Primary}" HeightRequest="4" />
                                <Label Text="{Binding DetailText}" Style="{StaticResource HintText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource BodyText}" FontAttributes="Bold" VerticalOptions="Center" />
                            <CheckBox Grid.Column="3" IsChecked="{Binding IsChecked, Mode=TwoWay}" Color="{StaticResource Primary}" VerticalOptions="Center" CheckedChanged="OnItemCheckedChanged" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Tipos de fichero y antigüedad: filas agregadas. -->
        <CollectionView Grid.Row="1" x:Name="AggregateList" Margin="12,6,12,12" SelectionMode="None" IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AggregateRow">
                    <Border Style="{StaticResource ListRow}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding Label}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                <ProgressBar Progress="{Binding Percent}" ProgressColor="{StaticResource Primary}" HeightRequest="4" />
                                <Label Text="{Binding DetailText}" Style="{StaticResource HintText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource BodyText}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Duplicados: un grupo por tarjeta, con sus copias dentro (cada copia se puede elegir). -->
        <CollectionView Grid.Row="1" x:Name="DuplicatesList" Margin="12,6,12,12" SelectionMode="None" IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DuplicateGroup">
                    <Border Style="{StaticResource ListRow}" Padding="12,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource BodyText}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                            <Label Text="{Binding Detail}" Style="{StaticResource HintText}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileRow">
                                        <Grid Padding="8,0,0,0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" BackgroundColor="{Binding RowColor}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDuplicateRowTapped" />
                                                <TapGestureRecognizer Buttons="Secondary" Tapped="OnRowSecondaryTapped" />
                                            </Grid.GestureRecognizers>
                                            <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding FullPath}" Style="{StaticResource HintText}" LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding DetailText}" Style="{StaticResource HintText}" VerticalOptions="Center" />
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsChecked, Mode=TwoWay}" Color="{StaticResource Primary}" VerticalOptions="Center" MinimumHeightRequest="30" CheckedChanged="OnItemCheckedChanged" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Cola de ordenes en segundo plano (papelera, borrar, permisos, exportar): se puede seguir
             trabajando mientras. Cada una con su progreso y para pararla; las que fallan se quedan
             con el motivo hasta quitarlas. -->
        <Border Grid.Row="2" x:Name="QueuePanel" Style="{StaticResource Card}" Margin="12,0,12,12" Padding="10,6" IsVisible="False">
            <ScrollView MaximumHeightRequest="190">
                <VerticalStackLayout x:Name="QueueList" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:QueuedJob">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,2">
                                <Grid Grid.Column="0" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                    <!-- Icono fijo y no la rueda animada: las ordenes rapidas la creaban y destruian
                                         en milisegundos, y el ProgressRing de WinUI no lo lleva bien. -->
                                    <Image Source="ic_refresh.png" IsVisible="{Binding IsRunning}" WidthRequest="18" HeightRequest="18" />
                                    <Image Source="ic_clock.png" IsVisible="{Binding IsPending}" WidthRequest="18" HeightRequest="18" Opacity="0.6" />
                                    <Label Text="!" IsVisible="{Binding IsFailed}" TextColor="#D14343" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyText}" LineBreakMode="MiddleTruncation" />
                                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding IsRunning}" ProgressColor="{StaticResource Primary}" HeightRequest="4" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource HintText}" LineBreakMode="MiddleTruncation" />
                                </VerticalStackLayout>
                                <Grid Grid.Column="2" VerticalOptions="Center">
                                    <Button Style="{StaticResource IconButton}" ImageSource="ic_stop.png" IsVisible="{Binding CanCancel}" Clicked="OnJobCancelClicked" />
                                    <Button Style="{StaticResource IconButton}" ImageSource="ic_clear_selection.png" IsVisible="{Binding IsFailed}" Clicked="OnJobDismissClicked" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>

</ContentPage>
